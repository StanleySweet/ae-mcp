<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AeMcpSetup.ViewModels"
        x:Class="AeMcpSetup.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AE-MCP Setup"
        Width="540" Height="580" MinWidth="460" MinHeight="480">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Spacing="3">
            <TextBlock Text="AE-MCP Setup" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.65" FontSize="13" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Install" Command="{Binding InstallCommand}" Classes="accent" />
                <Button Content="Uninstall" Command="{Binding UninstallCommand}" />
                <Button Content="Export diagnostics" Command="{Binding DiagnosticsCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Progress}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,18,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChecklistRowViewModel">
                    <Border Background="#18808080" CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Label}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Fix}" IsVisible="{Binding HasFix}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="10" Padding="10,3"
                                    VerticalAlignment="Center" Background="{Binding StatusBrush}">
                                <TextBlock Text="{Binding StatusText}" Foreground="White"
                                           FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
