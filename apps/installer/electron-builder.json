{
  "appId": "com.aemcp.setup",
  "productName": "AE-MCP Setup",
  "directories": { "output": "dist" },
  "files": [
    "dist/main.js",
    "dist/preload.js",
    "dist/renderer.js",
    "dist/payload.jsx",
    "dist/loader.jsx",
    "index.html",
    "package.json"
  ],
  "extraResources": [{ "from": "resources", "to": "." }],
  "mac": {
    "category": "public.app-category.developer-tools",
    "identity": null,
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      { "target": "zip", "arch": ["arm64", "x64"] }
    ]
  },
  "dmg": {
    "contents": [
      { "x": 150, "y": 190 },
      { "x": 400, "y": 190, "type": "link", "path": "/Applications" }
    ]
  }
}
