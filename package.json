{
  "name": "ae-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets Claude Desktop see and edit the After Effects project the user has open.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "bundle:pack": "tsx bundle/pack.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run bridge:lint-es3 && npm run bridge:build && npm run bundle:pack && npm run bundle:smoke",
    "spike:bench": "tsx packages/spike/src/benchmark.ts",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "bridge:lint-es3": "eslint --config packages/bridge/es3-lint.config.js \"packages/bridge/src/*.js\"",
    "installer:build": "tsx apps/installer/build.ts && electron-builder --projectDir apps/installer",
    "test": "vitest run",
    "bridge:build": "tsx packages/bridge/src/build.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "bundle:smoke": "tsx bundle/smoke.ts"
  }
}
